PCM_ENVIRONMENT=development
PCM_DATABASE_URL=postgresql+psycopg://catalog:catalog@localhost:5432/catalog
PCM_LOG_FORMAT=json
PCM_UPLOAD_MAX_BYTES=5242880
PCM_IMPORT_MAX_ROWS=5000
