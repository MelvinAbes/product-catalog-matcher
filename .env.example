POSTGRES_PASSWORD=replace-with-a-local-password
PCM_APP_PORT=8000
PCM_DB_PORT=5432
PCM_ENVIRONMENT=development
PCM_DATABASE_URL=postgresql+psycopg://catalog:replace-with-a-local-password@localhost:5432/catalog
PCM_LOG_FORMAT=json
PCM_UPLOAD_MAX_BYTES=5242880
PCM_IMPORT_MAX_ROWS=5000
PCM_AUTO_MATCH_THRESHOLD=0.80
PCM_REVIEW_THRESHOLD=0.65
PCM_MINIMUM_WINNING_MARGIN=0.08
PCM_CANDIDATE_SIMILARITY_FLOOR=0.25
PCM_CANDIDATE_LIMIT=20
PCM_PROPOSAL_LIMIT=3
PCM_SEMANTIC_MATCHING_ENABLED=false
PCM_SEMANTIC_MODEL=sentence-transformers/all-MiniLM-L6-v2
