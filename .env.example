PCM_CANDIDATE_LIMIT=20
PCM_PROPOSAL_LIMIT=3
PCM_SEMANTIC_MATCHING_ENABLED=false
PCM_SEMANTIC_MODEL=sentence-transformers/all-MiniLM-L6-v2
